{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowJWTAuthenticatedAccess",
      "Effect": "Allow",
      "Principal": { "AWS": "*" },
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::task-files/user/*"],
      "Condition": {
        "StringEquals": {
          "jwt:preferred_username": "${s3:username}"
        }
      }
    }
  ]
}
