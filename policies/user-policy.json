{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowUserFileOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": ["arn:aws:s3:::task-files/user/${jwt:preferred_username}/*"]
    },
    {
      "Sid": "AllowBucketOperations",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::task-files"]
    }
  ]
}
